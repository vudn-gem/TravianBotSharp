<v:ConquestTabBase
    x:Class="WPFUI.Views.Tabs.ConquestTab"
    xmlns:v="clr-namespace:WPFUI.Views.Tabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="clr-namespace:MainCore.Models;assembly=MainCore"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <v:ConquestTabBase.Resources>
        <CollectionViewSource x:Key="CatapultTargets" Source="{x:Static models:ConquestCatapultTargets.Options}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="OptionalCatapultTargets" Source="{x:Static models:ConquestCatapultTargets.OptionalOptions}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="CatapultTargetSelector" TargetType="ComboBox">
            <Setter Property="DisplayMemberPath" Value="Name" />
            <Setter Property="SelectedValuePath" Value="Value" />
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <DataTemplate x:Key="TargetGroupHeader">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4" />
        </DataTemplate>
    </v:ConquestTabBase.Resources>
    <Grid Background="#FFE5E5E5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Margin="8" Padding="12" Style="{DynamicResource Box}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Plan a timed attack" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Origin village" />
                            <ComboBox x:Name="OriginVillage" MinWidth="240">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Origin coordinates" />
                            <TextBlock x:Name="OriginCoordinates" Margin="0,6" />
                            <TextBlock x:Name="TournamentSquareLevel" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Target X (-200 to 200)" />
                            <TextBox x:Name="TargetX" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="Target Y (-200 to 200)" />
                            <TextBox x:Name="TargetY" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="4">
                            <TextBlock Text="Arrival date" />
                            <DatePicker x:Name="ArrivalDate" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4">
                            <TextBlock Text="Arrival time (HH:mm:ss)" />
                            <TextBox x:Name="ArrivalTime" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="4">
                            <TextBlock Text="Slowest troop speed (fields/hour)" />
                            <TextBox x:Name="SlowestTroopSpeed" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="4">
                            <TextBlock Text="Boots bonus (%)" />
                            <TextBox x:Name="BootsPercent" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="4">
                            <TextBlock Text="Artifact multiplier (1 = none)" />
                            <TextBox x:Name="ArtifactMultiplier" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="4">
                            <TextBlock Text="Network delay (seconds)" />
                            <TextBox x:Name="DelaySeconds" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="4,12,4,4"
                               FontWeight="SemiBold"
                               Text="Troop waves" />
                    <TextBlock Margin="4" TextWrapping="Wrap"
                               Text="t1-t10 follow the Rally Point troop order; t8 = Catapult, last = Hero. Target 2 is optional and available from 20 catapults. Targets use the game's names and values; availability is checked when preparing the attack." />
                    <ItemsControl x:Name="TroopWaves">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="DarkGray" BorderThickness="1" Padding="6" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Number, StringFormat='Wave {0}'}" FontWeight="SemiBold" Margin="4" />
                                        <ItemsControl ItemsSource="{Binding Troops}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="11" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   MinHeight="48" HorizontalAlignment="Center" />
                                                        <TextBox Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinWidth="38" HorizontalContentAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel>
                                            <StackPanel>
                                                <TextBlock Text="Catapult target 1" Margin="4,4,4,0" />
                                                <ComboBox Style="{StaticResource CatapultTargetSelector}"
                                                          ItemsSource="{Binding Source={StaticResource CatapultTargets}}"
                                                          IsEnabled="{Binding HasCatapults}"
                                                          SelectedValue="{Binding CatapultTarget1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.GroupStyle>
                                                        <GroupStyle HeaderTemplate="{StaticResource TargetGroupHeader}" />
                                                    </ComboBox.GroupStyle>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Catapult target 2 (20+)" Margin="4,4,4,0" />
                                                <ComboBox Style="{StaticResource CatapultTargetSelector}"
                                                          ItemsSource="{Binding Source={StaticResource OptionalCatapultTargets}}"
                                                          IsEnabled="{Binding CanSelectSecondTarget}"
                                                          SelectedValue="{Binding CatapultTarget2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.GroupStyle>
                                                        <GroupStyle HeaderTemplate="{StaticResource TargetGroupHeader}" />
                                                    </ComboBox.GroupStyle>
                                                </ComboBox>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AddWaveButton" Content="Add" Margin="4" Padding="14,6" />
                        <Button x:Name="CopyWaveButton" Content="Copy last wave" Margin="4" Padding="14,6" />
                    </StackPanel>
                    <TextBlock x:Name="PlanPreview"
                               Margin="4,12"
                               TextWrapping="Wrap" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="CalculatePlanButton" Content="Calculate" Margin="4" Padding="14,6" />
                        <Button x:Name="ActionButton" Content="Action" Margin="4" Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</v:ConquestTabBase>
