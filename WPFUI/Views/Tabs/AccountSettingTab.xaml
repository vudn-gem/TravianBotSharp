<v:AccountSettingTabBase
    x:Class="WPFUI.Views.Tabs.AccountSettingTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:WPFUI.Views.UserControls"
    xmlns:v="clr-namespace:WPFUI.Views.Tabs"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#FFE5E5E5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SaveButton"
                Grid.Column="0"
                ToolTip="Save">
                <materialDesign:PackIcon
                    Width="{DynamicResource IconSize}"
                    Height="{DynamicResource IconSize}"
                    Kind="ContentSave" />
            </Button>
            <Button
                x:Name="ImportButton"
                Grid.Column="1"
                Width="{DynamicResource ButtonWidth}"
                Style="{DynamicResource MaterialDesignRaisedDarkButton}"
                ToolTip="Import">
                <materialDesign:PackIcon
                    Width="{DynamicResource IconSize}"
                    Height="{DynamicResource IconSize}"
                    Kind="Import" />
            </Button>
            <Button
                x:Name="ExportButton"
                Grid.Column="2"
                Width="{DynamicResource ButtonWidth}"
                Style="{DynamicResource MaterialDesignRaisedDarkButton}"
                ToolTip="Export">
                <materialDesign:PackIcon
                    Width="{DynamicResource IconSize}"
                    Height="{DynamicResource IconSize}"
                    Kind="Export" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Activity settings"
                            TextWrapping="Wrap" />
                        <uc:RangeInputUc
                            x:Name="WorkTime"
                            Text="Work time"
                            Unit="minutes" />
                        <uc:RangeInputUc
                            x:Name="SleepTime"
                            Text="Sleep time"
                            Unit="minutes" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Delay settings"
                            TextWrapping="Wrap" />
                        <uc:RangeInputUc
                            x:Name="ClickDelay"
                            Text="Click delay"
                            Unit="milliseconds" />
                        <uc:RangeInputUc
                            x:Name="TaskDelay"
                            Text="Task delay"
                            Unit="milliseconds" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Feature settings"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="EnableAutoLoadVillage" Content="Enable auto load village's building" />
                        <CheckBox x:Name="EnableAutoStartAdventure" Content="Enable auto start adventure" />
                        <CheckBox x:Name="EnableAutoClaimDailyQuest" Content="Enable auto claim daily quest" />
                        <CheckBox x:Name="EnableAutoSetHeroPoint" Content="Enable auto set hero point (1 power, 3 res)" />
                        <CheckBox x:Name="EnableReportNotifications" Content="Notify on report badge increase (Telegram)" />
                        <CheckBox x:Name="EnableAutoDeactivateLostReportTargets" Content="Deactivate farm targets from unread lost offensive reports" />
                        <CheckBox x:Name="EnableIncomingTroopsNotifications" Content="Notify on incoming attack/raid (Telegram)" />
                        <CheckBox x:Name="EnableBotStopNotifications" Content="Notify when bot stops due to an error (Telegram)" />
                        <CheckBox x:Name="EnableScheduledMonitoring" Content="Enable scheduled report and incoming scans" />
                        <uc:RangeInputUc x:Name="ScheduledMonitoringInterval" Text="Scheduled scan interval" Unit="minutes" />
                        <TextBlock Margin="0,5" TextWrapping="Wrap" Text="Scheduled scans run independently of farming when at least one Telegram notification switch is enabled. The bot switches village overview pages before scanning. The interval must be 1 to 1440 minutes." />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="Telegram notifications (shared by all accounts)" />
                        <TextBlock Margin="0,5" TextWrapping="Wrap"
                                   Text="Message /start to your bot first. Save Telegram settings before enabling notifications. Leave the token blank to keep the saved token." />
                        <PasswordBox x:Name="TelegramBotToken" Margin="0,5"
                                     materialDesign:HintAssist.Hint="Bot token" />
                        <TextBox x:Name="TelegramChatId" Margin="0,5"
                                 materialDesign:HintAssist.Hint="Numeric chat ID" />
                        <Button x:Name="SaveTelegramButton" Margin="0,5" Content="Save Telegram settings" />
                        <Button x:Name="TestTelegramButton" Margin="0,5" Content="Send test message" />
                        <TextBlock Margin="0,5" TextWrapping="Wrap"
                                   Text="Report checks run before Start farm list and also on the scheduled scan when enabled. Start/restart/resume establishes a new baseline without sending a message. Reports read between scans may be missed." />
                        <TextBlock Margin="0,5" TextWrapping="Wrap"
                                   Text="Incoming checks after successful tasks are at least 60 seconds apart; scheduled scans also run at their configured interval. Long tasks, sleep or pause can delay checks. Reads English tooltip counts; alerts on first detection or count increases." />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Chrome settings"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="HeadlessChrome" Content="Use headless chrome" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</v:AccountSettingTabBase>