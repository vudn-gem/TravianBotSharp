<v:FarmingTabBase
    x:Class="WPFUI.Views.Tabs.FarmingTab"
    xmlns:v="clr-namespace:WPFUI.Views.Tabs"
    xmlns:uc="clr-namespace:WPFUI.Views.UserControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFUI.Views.Tabs"
    mc:Ignorable="d"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FFE5E5E5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource Box}" Grid.Row="0">
                <ListBox x:Name="FarmlistGrid" SelectionMode="Single" ItemTemplate="{DynamicResource ListBoxColorItem}" />
            </Border>
            <Button x:Name="Load" Grid.Row="1" Content="Load farmlist" ToolTip="Load farmlist" Margin="5,0,5,5" />
        </Grid>
        <Border Style="{DynamicResource Box}" Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel                     Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Margin="0,20,0,0">
                        <uc:RangeInputUc x:Name="FarmInterval" Text="Start farm delay" Unit="s" />
                        <CheckBox x:Name="UseStartAllCheckbox" Content="Use Start all button (ignore active settings)" />
                    </StackPanel>
                    <Button x:Name="SaveButton" ToolTip="Save"                              Margin="10">
                        <materialDesign:PackIcon Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Kind="ContentSave" />
                    </Button>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center" Margin="10">
                    <Button x:Name="ActiveButton" Margin="10" />
                    <Button x:Name="CheckTargetTroopsButton" Content="Check oasis" Margin="10"
                            ToolTip="Check oasis targets and deactivate those containing troops" />
                    <GroupBox x:Name="OasisSettingsGroup" Header="Selected farm list oasis settings" Margin="10,0,10,10">
                        <StackPanel Margin="8">
                            <uc:AmountInputUc x:Name="OasisRaidSafetyFactor" Text="Oasis raid safety factor" Unit="x" />
                            <uc:AmountInputUc x:Name="LimitAnimal" Text="Limit animal (0 = unlimited)" Unit="animals" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Attack troop" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="OasisAttackTroop" Width="140">
                                    <ComboBoxItem Content="Steppe Rider" />
                                    <ComboBoxItem Content="Marksman" />
                                    <ComboBoxItem Content="Marauder" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Raid troops (empty oasis)" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <WrapPanel Orientation="Horizontal">
                                <uc:AmountInputUc x:Name="RaidSteppeRiders" Text="Steppe Rider" Unit="troops" Margin="0,0,12,0" />
                                <uc:AmountInputUc x:Name="RaidMarksmen" Text="Marksman" Unit="troops" Margin="0,0,12,0" />
                                <uc:AmountInputUc x:Name="RaidMarauders" Text="Marauder" Unit="troops" />
                            </WrapPanel>
                            <TextBlock Text="Allowed oasis animals" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox x:Name="AllowRatOasisCheckBox" Content="Rat" Margin="0,0,12,4" />
                                <CheckBox x:Name="AllowSpiderOasisCheckBox" Content="Spider" Margin="0,0,12,4" />
                                <CheckBox x:Name="AllowSnakeOasisCheckBox" Content="Snake" Margin="0,0,12,4" />
                                <CheckBox x:Name="AllowBatOasisCheckBox" Content="Bat" Margin="0,0,12,4" />
                                <CheckBox x:Name="AllowWildBoarOasisCheckBox" Content="Wild Boar" Margin="0,0,12,4" />
                                <CheckBox x:Name="AllowWolfOasisCheckBox" Content="Wolf" Margin="0,0,12,4" />
                                <CheckBox x:Name="AllowBearOasisCheckBox" Content="Bear" Margin="0,0,12,4" />
                                <CheckBox x:Name="AllowCrocodileOasisCheckBox" Content="Crocodile" Margin="0,0,12,4" />
                                <CheckBox x:Name="AllowTigerOasisCheckBox" Content="Tiger" Margin="0,0,12,4" />
                                <CheckBox x:Name="AllowElephantOasisCheckBox" Content="Elephant" Margin="0,0,12,4" />
                            </WrapPanel>
                            <Button x:Name="SaveOasisSettingsButton" Content="Save oasis settings" Margin="0,8,0,0" />
                            <Button x:Name="ClearOasisButton" Content="Clear oasis" Margin="0,8,0,0"
                                    ToolTip="Use the selected farm list's troop settings to raid oasis targets" />
                            <Button x:Name="RemoveClearOasisButton" Content="Remove clear oasis task" Margin="0,8,0,0"
                                    ToolTip="Remove the waiting clear oasis task for the selected farm list" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="HeroOasisSettingsGroup" Header="Hero clear oasis - selected farm list" Margin="10,0,10,10">
                        <StackPanel Margin="8">
                            <WrapPanel>
                                <uc:AmountInputUc x:Name="HeroMinAnimal" Text="Min animal" Unit="animals" Margin="0,0,12,0" />
                                <uc:AmountInputUc x:Name="HeroMaxAnimal" Text="Max animal" Unit="animals" />
                            </WrapPanel>
                            <TextBlock Text="Sub troops accompanying one hero (Hun)" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <WrapPanel>
                                <uc:AmountInputUc x:Name="HeroSteppeRiders" Text="Steppe Rider" Unit="troops" Margin="0,0,12,0" />
                                <uc:AmountInputUc x:Name="HeroMarksmen" Text="Marksman" Unit="troops" Margin="0,0,12,0" />
                                <uc:AmountInputUc x:Name="HeroMarauders" Text="Marauder" Unit="troops" />
                            </WrapPanel>
                            <TextBlock Text="Allowed oasis animals" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <WrapPanel>
                                <CheckBox x:Name="HeroAllowRat" Content="Rat" Margin="0,0,12,4" />
                                <CheckBox x:Name="HeroAllowSpider" Content="Spider" Margin="0,0,12,4" />
                                <CheckBox x:Name="HeroAllowSnake" Content="Snake" Margin="0,0,12,4" />
                                <CheckBox x:Name="HeroAllowBat" Content="Bat" Margin="0,0,12,4" />
                                <CheckBox x:Name="HeroAllowWildBoar" Content="Wild Boar" Margin="0,0,12,4" />
                                <CheckBox x:Name="HeroAllowWolf" Content="Wolf" Margin="0,0,12,4" />
                                <CheckBox x:Name="HeroAllowBear" Content="Bear" Margin="0,0,12,4" />
                                <CheckBox x:Name="HeroAllowCrocodile" Content="Crocodile" Margin="0,0,12,4" />
                                <CheckBox x:Name="HeroAllowTiger" Content="Tiger" Margin="0,0,12,4" />
                                <CheckBox x:Name="HeroAllowElephant" Content="Elephant" Margin="0,0,12,4" />
                            </WrapPanel>
                            <GroupBox Header="Hero farm settings" Margin="0,8,0,0">
                                <StackPanel Margin="8">
                                    <uc:AmountInputUc x:Name="HeroMinHealth" Text="Min hero health allow" Unit="%" />
                                    <uc:AmountInputUc x:Name="HeroMaxHealthLost" Text="Max hero health lost" Unit="points" />
                                    <uc:AmountInputUc x:Name="HeroMaxSubTroopLost" Text="Max sub troop lost" Unit="troops" />
                                    <TextBlock Text="Min health applies before and after simulation. Limits are inclusive." TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <Button x:Name="SaveHeroOasisSettingsButton" Content="Save hero oasis settings" Margin="0,8,0,0" />
                            <Button x:Name="HeroClearOasisButton" Content="Hero clear oasis" Margin="0,8,0,0" />
                            <Button x:Name="RemoveHeroClearOasisButton" Content="Remove hero clear oasis task" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
                <Button x:Name="StartButton"    Grid.Row="2" ToolTip="Start" Margin="10">
                    <materialDesign:PackIcon Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Kind="Play" />
                </Button>
                <Button x:Name="StopButton"     Grid.Row="3" ToolTip="Stop"             Margin="10">
                    <materialDesign:PackIcon Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Kind="Stop" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</v:FarmingTabBase>
